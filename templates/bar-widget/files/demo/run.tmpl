#!/usr/bin/env bash
set -euo pipefail

state="${1:-ready}"
case "$state" in
  ready|empty|error) ;;
  *) echo "Usage: ./demo/run [ready|empty|error]" >&2; exit 2 ;;
esac

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
printf 'Fictional demo state: %s\n' "$state"
printf 'Fixture: %s\n' "$repo_root/demo/fixtures.json"
printf '\nTo launch an isolated shell demo, start Omarchy Shell with:\n'
printf '  OMAFORGE_DEMO_STATE=%q omarchy-restart-shell\n' "$state"
printf '\nRestart the shell normally afterward. This script itself changes no configuration.\n'
